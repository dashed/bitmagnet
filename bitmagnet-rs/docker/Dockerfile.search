# syntax=docker/dockerfile:1
#
# Multi-stage build for the bitmagnet Tantivy search sidecar.
#
#   docker build -f bitmagnet-rs/docker/Dockerfile.search -t bitmagnet-search bitmagnet-rs
#
# Builder and runtime are both pinned to Debian bookworm so the glibc the binary
# is linked against matches the runtime image.

# ---- builder ----------------------------------------------------------------
FROM rust:1.95-slim-bookworm AS builder

# protoc is required by the bitmagnet-proto build script (tonic-prost-build).
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the whole workspace; .dockerignore keeps target/ and VCS noise out.
COPY . .

# Build only the search sidecar, in release mode.
RUN cargo build --release -p bitmagnet-search

# ---- runtime ----------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# Non-root user (uid/gid 65532, the conventional "nonroot" id).
RUN groupadd --system --gid 65532 bitmagnet \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --home /nonexistent bitmagnet \
    && mkdir -p /var/lib/bitmagnet/search /var/lib/bitmagnet/pathsearch \
    && chown -R 65532:65532 /var/lib/bitmagnet

COPY --from=builder /build/target/release/bitmagnet-search /usr/local/bin/bitmagnet-search
COPY --from=builder /build/target/release/bitmagnet-pathsearch /usr/local/bin/bitmagnet-pathsearch
COPY --from=builder /build/target/release/bitmagnet-pathsearch-backfill /usr/local/bin/bitmagnet-pathsearch-backfill

# Listen on all interfaces inside the container; the index dirs live under
# /var/lib/bitmagnet, which the orchestrator backs with a persistent volume
# mounted at that PARENT path.
ENV BITMAGNET_SEARCH_ADDR=0.0.0.0:50051 \
    BITMAGNET_SEARCH_INDEX=/var/lib/bitmagnet/search \
    BITMAGNET_PATHSEARCH_ADDR=0.0.0.0:50053 \
    BITMAGNET_PATHSEARCH_INDEX=/var/lib/bitmagnet/pathsearch
# NO `VOLUME` directive: an image VOLUME at /var/lib/bitmagnet/{search,pathsearch}
# makes containerd create an EPHEMERAL anonymous volume at those subpaths that
# SHADOWS a PVC mounted at the parent /var/lib/bitmagnet — every index write then
# lands on pod-ephemeral storage and is wiped on restart. The index must persist,
# so the volume is supplied by the deployment (PVC at the parent mount), never by
# the image.

USER 65532:65532
# 50051 = SearchService (default entrypoint); 50053 = PathSearchService when the
# image is run as the bitmagnet-pathsearch binary.
EXPOSE 50051 50053
# Health is exposed via the SearchService.HealthCheck RPC; wire a gRPC probe
# (e.g. grpc_health_probe) in the orchestrator rather than a shell HEALTHCHECK.
ENTRYPOINT ["/usr/local/bin/bitmagnet-search"]
