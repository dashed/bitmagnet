# syntax=docker/dockerfile:1
#
# One fail-closed executable, run as separate `mirror` and `consume`
# Deployments. Neither mode persists processor writes to live tables.
#
#   docker build -f bitmagnet-rs/docker/Dockerfile.ingest-shadow \
#     --build-arg REVISION="$(git rev-parse HEAD)" \
#     --build-arg SOURCE_TREE="$(git rev-parse 'HEAD^{tree}')" \
#     -t bitmagnet-ingest-shadow .

ARG REVISION
ARG SOURCE_TREE

FROM rust:1.97.1-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS builder
ENV RUSTUP_TOOLCHAIN=1.97.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY bitmagnet-rs ./bitmagnet-rs
COPY internal/classifier/classifier.core.yml ./internal/classifier/classifier.core.yml
RUN cargo build --manifest-path bitmagnet-rs/Cargo.toml --locked --release \
      -p bitmagnet-processor --bin bitmagnet-ingest-shadow \
    && install -D -m 0755 bitmagnet-rs/target/release/bitmagnet-ingest-shadow \
      /out/bitmagnet-ingest-shadow \
    && rm -rf bitmagnet-rs/target

FROM debian:bookworm-slim AS runtime
ARG REVISION
ARG SOURCE_TREE

# Reject unbound or ambiguous source identity at image-build time.
RUN set -eu; \
    test "${#REVISION}" -eq 40; \
    case "${REVISION}" in *[!0-9a-f]*) echo "REVISION must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac; \
    test "${#SOURCE_TREE}" -eq 40; \
    case "${SOURCE_TREE}" in *[!0-9a-f]*) echo "SOURCE_TREE must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac

LABEL org.opencontainers.image.source="https://github.com/dashed/bitmagnet" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${REVISION}" \
      io.bitmagnet.source-tree="${SOURCE_TREE}" \
      io.bitmagnet.ingest-shadow-contract="live-tables-read-only/v1"

ENV BITMAGNET_SOURCE_COMMIT="${REVISION}" \
    BITMAGNET_SOURCE_TREE="${SOURCE_TREE}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 bitmagnet \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --home /nonexistent bitmagnet

COPY --from=builder /out/bitmagnet-ingest-shadow /usr/local/bin/bitmagnet-ingest-shadow

USER 65532:65532
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/bitmagnet-ingest-shadow"]
