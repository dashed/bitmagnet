# syntax=docker/dockerfile:1
#
# Track E — offline write-set replay harness. A one-shot, strictly read-only
# parity job: it replays archived `process_torrent` payloads and diffs the
# materialized Rust write-set against the settled live rows. It never writes to
# the database and never touches the queue.
#
# Deliberately a separate image from Dockerfile.ingest-shadow: that one builds
# only `--bin bitmagnet-ingest-shadow`, and the shadow mirror/consumer
# Deployments must not be disturbed to run this.
#
# Like the shadow image, this copies both bitmagnet-rs and the Go classifier
# core, so it needs the repository-root archive and build context.
#
# It carries a SECOND gate runner, `bitmagnet-localsearch-replay`, which
# re-issues a recorded tape's local-search requests against live PostgreSQL and
# diffs the answers. Same read-only guarantees, same SELECT-only role, same
# one-shot Job shape — so it rides in this image rather than duplicating the
# build. The ENTRYPOINT stays the write-set runner; select the other with an
# explicit `command:`.

ARG REVISION
ARG SOURCE_TREE

FROM --platform=$BUILDPLATFORM golang:1.23.6-bookworm AS go-builder
ARG REVISION
ARG TARGETOS
ARG TARGETARCH
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
      go build -trimpath \
        -ldflags "-s -w -X github.com/bitmagnet-io/bitmagnet/internal/version.GitTag=${REVISION}" \
        -o /out/bitmagnet ./main.go

FROM rust:1.97.1-slim-bookworm@sha256:2775a09d208ff0d7c1f50490c45b62db929e87ba1dcbc3f2132ac71a704bcdd3 AS rust-builder
ENV RUSTUP_TOOLCHAIN=1.97.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY bitmagnet-rs ./bitmagnet-rs
COPY internal/classifier/classifier.core.yml ./internal/classifier/classifier.core.yml
RUN cargo build --manifest-path bitmagnet-rs/Cargo.toml --locked --release \
      -p bitmagnet-processor \
      --bin bitmagnet-writeset-replay --bin bitmagnet-localsearch-replay \
      --bin bitmagnet-tape-rerun \
    && install -D -m 0755 bitmagnet-rs/target/release/bitmagnet-writeset-replay \
      /out/bitmagnet-writeset-replay \
    && install -D -m 0755 bitmagnet-rs/target/release/bitmagnet-localsearch-replay \
      /out/bitmagnet-localsearch-replay \
    && install -D -m 0755 bitmagnet-rs/target/release/bitmagnet-tape-rerun \
      /out/bitmagnet-tape-rerun \
    && rm -rf bitmagnet-rs/target

FROM debian:bookworm-slim AS runtime
ARG REVISION
ARG SOURCE_TREE

RUN set -eu; \
    test "${#REVISION}" -eq 40; \
    case "${REVISION}" in *[!0-9a-f]*) echo "REVISION must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac; \
    test "${#SOURCE_TREE}" -eq 40; \
    case "${SOURCE_TREE}" in *[!0-9a-f]*) echo "SOURCE_TREE must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac

LABEL org.opencontainers.image.source="https://github.com/bitmagnet-io/bitmagnet" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${REVISION}" \
      io.bitmagnet.source-tree="${SOURCE_TREE}" \
      io.bitmagnet.classifier-tape-parity-contract="bitmagnet.classifier-tape-parity/v1"

ENV BITMAGNET_SOURCE_COMMIT="${REVISION}" \
    BITMAGNET_SOURCE_TREE="${SOURCE_TREE}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 bitmagnet \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --home /nonexistent bitmagnet

COPY --from=go-builder /out/bitmagnet /usr/local/bin/bitmagnet
COPY --from=rust-builder /out/bitmagnet-writeset-replay /usr/local/bin/bitmagnet-writeset-replay
COPY --from=rust-builder /out/bitmagnet-localsearch-replay /usr/local/bin/bitmagnet-localsearch-replay
COPY --from=rust-builder /out/bitmagnet-tape-rerun /usr/local/bin/bitmagnet-tape-rerun

# The recorded corpus the local-search comparison diffs against. Baking it in
# keeps the job self-contained; it is a few hundred KB and this is a gate
# runner, not a serving image. 🚨 A new corpus therefore needs a new image.
COPY testdata/parity/classifier-attach /opt/bitmagnet/tapes

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/bitmagnet-writeset-replay"]
