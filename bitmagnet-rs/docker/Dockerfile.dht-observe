# syntax=docker/dockerfile:1
#
# Dedicated image for the PostgreSQL-nonmutating Rust DHT observer.
#
#   docker build -f docker/Dockerfile.dht-observe \
#     --build-arg REVISION="$(git -C .. rev-parse HEAD)" \
#     --build-arg SOURCE_TREE="$(git -C .. rev-parse 'HEAD^{tree}')" \
#     -t bitmagnet-dht-observe .

ARG REVISION
ARG SOURCE_TREE

FROM rust:1.97-slim-bookworm AS builder
ENV RUSTUP_TOOLCHAIN=1.97.0

# The workspace contains tonic crates whose shared build script requires
# protoc even though this executable exposes only HTTP and UDP.
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

RUN cargo build --locked --release \
      -p bitmagnet-dht-observe --bin bitmagnet-dht-observe \
    && install -D -m 0755 target/release/bitmagnet-dht-observe \
      /out/bitmagnet-dht-observe \
    && rm -rf target

FROM debian:bookworm-slim AS runtime
ARG REVISION
ARG SOURCE_TREE

# Reject unbound or ambiguous source identity at image-build time.
RUN set -eu; \
    test "${#REVISION}" -eq 40; \
    case "${REVISION}" in *[!0-9a-f]*) echo "REVISION must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac; \
    test "${#SOURCE_TREE}" -eq 40; \
    case "${SOURCE_TREE}" in *[!0-9a-f]*) echo "SOURCE_TREE must be 40 lowercase hexadecimal characters" >&2; exit 1 ;; esac

LABEL org.opencontainers.image.source="https://github.com/dashed/bitmagnet" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.revision="${REVISION}" \
      io.bitmagnet.source-tree="${SOURCE_TREE}" \
      io.bitmagnet.dht-mode="observe-only" \
      io.bitmagnet.dht-observe-contract="observe-only/v1"

ENV BITMAGNET_SOURCE_COMMIT="${REVISION}" \
    BITMAGNET_SOURCE_TREE="${SOURCE_TREE}" \
    HTTP_SERVER_LOCAL_ADDRESS="0.0.0.0:3333"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 bitmagnet \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --home /nonexistent bitmagnet

COPY --from=builder /out/bitmagnet-dht-observe /usr/local/bin/bitmagnet-dht-observe

# Metrics remain disabled unless BITMAGNET_METRICS_ADDR is explicitly set.
USER 65532:65532
EXPOSE 3333/tcp 3334/udp 9090/tcp
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/bitmagnet-dht-observe"]
CMD []
