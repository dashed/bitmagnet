FROM python:3.13.5-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY bench/graphql-rss/requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

COPY bitmagnet-rs/proto /proto
RUN mkdir -p /app/generated/bitmagnet \
    && touch /app/generated/bitmagnet/__init__.py \
    && python -m grpc_tools.protoc \
      -I/proto \
      --python_out=/app/generated \
      --grpc_python_out=/app/generated \
      /proto/bitmagnet/common.proto \
      /proto/bitmagnet/search.proto \
      /proto/bitmagnet/path_search.proto

COPY bench/graphql-rss/helper.py /app/helper.py

ENTRYPOINT ["python", "/app/helper.py"]
