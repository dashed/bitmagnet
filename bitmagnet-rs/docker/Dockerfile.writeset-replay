# syntax=docker/dockerfile:1
#
# Track E — offline write-set replay harness. A one-shot, strictly read-only
# parity job: it replays archived `process_torrent` payloads and diffs the
# materialized Rust write-set against the settled live rows. It never writes to
# the database and never touches the queue.
#
# Deliberately a separate image from Dockerfile.ingest-shadow: that one builds
# only `--bin bitmagnet-ingest-shadow`, and the shadow mirror/consumer
# Deployments must not be disturbed to run this.
#
# Like the shadow image, this copies both bitmagnet-rs and the Go classifier
# core, so it needs the repository-root archive and build context.

FROM rust:1.97-slim-bookworm AS builder
ENV RUSTUP_TOOLCHAIN=1.97.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY bitmagnet-rs ./bitmagnet-rs
COPY internal/classifier/classifier.core.yml ./internal/classifier/classifier.core.yml
RUN cargo build --manifest-path bitmagnet-rs/Cargo.toml --locked --release \
      -p bitmagnet-processor --bin bitmagnet-writeset-replay \
    && install -D -m 0755 bitmagnet-rs/target/release/bitmagnet-writeset-replay \
      /out/bitmagnet-writeset-replay \
    && rm -rf bitmagnet-rs/target

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 bitmagnet \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --home /nonexistent bitmagnet

COPY --from=builder /out/bitmagnet-writeset-replay /usr/local/bin/bitmagnet-writeset-replay

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/bitmagnet-writeset-replay"]
